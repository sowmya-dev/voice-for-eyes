# Copy to .env and fill in what you have. Every key is optional: the app starts without them.
# Never commit .env.

# Voice input (Sarvam speech-to-text)
SARVAM_API_KEY=

# Cloud help for surroundings and general questions (off by default in Settings)
OPENROUTER_API_KEY=
# Comma-separated, tried in order. Leave empty for the built-in free models.
OPENROUTER_MODELS=

# Strip detection fallback. It stays off until BOTH the key and a model id are set.
# Each model needs strip, full-pocket and empty-pocket classes (medicine_strip, full_cavity, empty_cavity, or renamed below).
ROBOFLOW_PRIVATE_API_KEY=
# One or more models (project/version), comma-separated, tried in order.
ROBOFLOW_MODEL_ID=
# Optional: rename a model's classes to ours, e.g. strip=medicine_strip,pill=full_cavity,missing=empty_cavity
ROBOFLOW_CLASS_MAP=

# Label text reading with Google Cloud Vision (label photos go to Google). Without it, labels are read on the device.
GOOGLE_CLOUD_VISION_API_KEY=

# Swappable engines. TEXT_READER: google or device (default: google when its key is set).
# POCKET_DETECTOR: roboflow or none (default: roboflow). The device reader is always the fallback.
TEXT_READER=
POCKET_DETECTOR=
# Optional. Defaults to https://serverless.roboflow.com
ROBOFLOW_API_URL=
# Roboflow keys below are not read by the backend yet.
ROBOFLOW_PUBLISHABLE_API_KEY=
ROBOFLOW_WORKSPACE_ID=

# Not read by the code yet.
ANTHROPIC_API_KEY=

# Speech detection tuning
STT_THRESHOLD=0.5
STT_SILENCE_MS=800
